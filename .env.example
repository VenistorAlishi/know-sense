# Смысл — local AI defaults
# Copy to .env.local (Next.js) or export in shell.

# --- MemPalace sidecar ---
PALACE_URL=http://127.0.0.1:3851
PALACE_PORT=3851
# Multilingual embeddings (RU+). Alternatives: minilm (EN-only), openai-compat
MEMPALACE_EMBEDDING_MODEL=embeddinggemma
MEMPALACE_LANG=ru
MEMPALACE_ENTITY_LANGUAGES=ru,en
# Flat ONNX dir (scripts/ensure-embeddinggemma.sh). Avoids ORT symlink bug.
# MEMPALACE_EMBEDDINGGEMMA_DIR=data/palace/models/embeddinggemma

# --- Chat LLM (auto-detects local Ollama if unset) ---
# Leave empty to auto-use Ollama when http://127.0.0.1:11434 is up.
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b

# Or point at any OpenAI-compatible API:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
