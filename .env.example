# Смысл — local AI defaults
# Copy to .env.local (Next.js) or export in shell.
# UI alternative: http://127.0.0.1:3847/settings (saves to data/store/llm-settings.json)

# --- MemPalace sidecar ---
PALACE_URL=http://127.0.0.1:3851
PALACE_PORT=3851
MEMPALACE_EMBEDDING_MODEL=embeddinggemma
MEMPALACE_LANG=ru
MEMPALACE_ENTITY_LANGUAGES=ru,en
# MEMPALACE_EMBEDDINGGEMMA_DIR=data/palace/models/embeddinggemma

# --- Chat LLM priority: env key → UI settings → Ollama → extractive ---
# LLM_PROVIDER=openai|anthropic|openrouter|ollama|auto

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenRouter (Claude/GPT/etc via one key)
# OPENROUTER_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-sonnet-4.5

# Local Ollama (auto if no cloud key)
LLM_MODEL=qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b

# --- Connectors ---
# Google Calendar + Drive (shared OAuth; enable both APIs in Google Cloud)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3847/api/connectors/google/callback
# Optional: limit Drive sync to one folder
# GOOGLE_DRIVE_FOLDER_ID=

# Voice ASR: optional OpenAI Whisper API (else local whisper / faster-whisper)
# OPENAI_API_KEY=sk-...
# WHISPER_MODEL=base

# Yandex Mail IMAP (пароль приложения: id.yandex.ru → Безопасность)
# YANDEX_MAIL_USER=you@yandex.ru
# YANDEX_MAIL_APP_PASSWORD=
# YANDEX_IMAP_HOST=imap.yandex.com
# YANDEX_IMAP_PORT=993

# Obsidian vault (one-way .md import; UI: /obsidian)
# OBSIDIAN_VAULT_PATH=/absolute/path/to/vault

