{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Смысл",
  "version": "0.1.0",
  "identifier": "com.smysl.jarvis",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ..",
    "devUrl": "http://127.0.0.1:3847/jarvis",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Смысл — Jarvis",
        "url": "http://127.0.0.1:3847/jarvis",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.png"
    ]
  }
}
