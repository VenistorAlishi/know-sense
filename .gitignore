# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local knowledge store and ingested raw sources
/data/store/knowledge.json
/data/store/llm-settings.json
/data/sources/*
!/data/sources/.gitkeep
/data/meetings/*
!/data/meetings/.gitkeep
/data/palace/**
!/data/palace/.gitkeep
# Large ONNX weights (downloaded by scripts/ensure-embeddinggemma.sh)
/data/palace/models/
/data/hallways.json
/data/tunnels.json
/services/palace/.venv/
.huggingface
.cache
